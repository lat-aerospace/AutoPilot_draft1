{
    "version": 4,
    "configurePresets": [
      {
        "name": "fprime",
        "displayName": "F´ Release Preset",
        "description": "F´ release build using local fprime-venv",
        "binaryDir": "${sourceDir}/build-fprime-automatic-native",
        "generator": "Ninja",
        "environment": {
          "VIRTUAL_ENV": "${fileDir}/fprime-venv",
          "PATH": "$env{VIRTUAL_ENV}/bin:$penv{PATH}"
        },
        "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "CMAKE_BUILD_TYPE": "Release"
        }
      },
      {
        "name": "fprime-debug",
        "inherits": "fprime",
        "displayName": "F´ Debug Preset",
        "description": "F´ debug build using local fprime-venv",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "fprime-ut",
        "inherits": "fprime-debug",
        "displayName": "F´ Unit Test Preset",
        "description": "F´ debug build including unit tests using local fprime-venv",
        "binaryDir": "${sourceDir}/build-fprime-automatic-native-ut",
        "cacheVariables": {
            "BUILD_TESTING": "ON"
        }
      },
      {
        "name": "sitl",
        "displayName": "SITL Deployment",
        "description": "Software-in-the-loop autopilot deployment",
        "inherits": "fprime-debug",
        "binaryDir": "${sourceDir}/build-sitl",
        "cacheVariables": {
            "FPRIME_DEPLOYMENT": "${sourceDir}/AP/Top/Sitl"
        }
      },
      {
        "name": "stm32h7",
        "displayName": "STM32H7 Hardware Deployment",
        "description": "Cross-compile for STM32H7xx (Cortex-M7 @ 480 MHz) with FreeRTOS",
        "binaryDir": "${sourceDir}/build-stm32h7",
        "generator": "Ninja",
        "environment": {
          "VIRTUAL_ENV": "${fileDir}/fprime-venv",
          "PATH": "$env{VIRTUAL_ENV}/bin:$penv{PATH}"
        },
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/stm32h7_toolchain.cmake",
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "FPRIME_PLATFORM": "stm32h7",
            "FPRIME_PLATFORM_CMAKE_PATH": "${sourceDir}/cmake/platform",
            "FPRIME_DEPLOYMENT": "${sourceDir}/AP/Top/Stm32"
        }
      },
      {
        "name": "stm32h7-debug",
        "inherits": "stm32h7",
        "displayName": "STM32H7 Debug Build",
        "description": "Cross-compile for STM32H7 with debug symbols and stack checking",
        "binaryDir": "${sourceDir}/build-stm32h7-debug",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "stm32f4",
        "displayName": "STM32F4 Hardware Deployment",
        "description": "Cross-compile for STM32F4xx (Cortex-M4F @ 168 MHz) with FreeRTOS",
        "binaryDir": "${sourceDir}/build-stm32f4",
        "generator": "Ninja",
        "environment": {
          "VIRTUAL_ENV": "${fileDir}/fprime-venv",
          "PATH": "$env{VIRTUAL_ENV}/bin:$penv{PATH}"
        },
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/stm32f4_toolchain.cmake",
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "FPRIME_PLATFORM": "stm32f4",
            "FPRIME_PLATFORM_CMAKE_PATH": "${sourceDir}/cmake/platform",
            "FPRIME_DEPLOYMENT": "${sourceDir}/AP/Top/Stm32"
        }
      }
  ]
}
